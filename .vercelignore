# Exclude large directories from serverless function
uploads/
database/
.git/
node_modules/
admin/

# Exclude large files
*.mp4
*.pdf
*.zip
*.tar.gz
*.sql

# Exclude image files (they should be served as static assets)
*.png
*.jpg
*.jpeg
*.gif
*.svg
*.webp

# Keep only PHP files and necessary config files
!api/
!*.php
!config.php
!vercel.json

