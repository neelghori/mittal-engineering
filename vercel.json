{
    "functions": {
      "api/**/*.php": {
        "runtime": "vercel-php@0.7.4",
        "excludeFiles": "{uploads/**,database/**,*.mp4,*.pdf,*.sql}"
      }
    },
    "routes": [
      { "src": "/uploads/(.*)", "dest": "/uploads/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
      { "src": "/(.*\\.(png|jpg|jpeg|gif|pdf|mp4|css|js|ico|svg|woff|woff2|ttf|eot))", "dest": "/$1", "headers": { "Cache-Control": "public, max-age=31536000, immutable" } },
      { "src": "/admin/(.*)", "dest": "/api/admin/$1" },
      { "src": "/admin/add-product.php", "dest": "/api/admin/add-product.php" },
      { "src": "/admin/admin-dashboard.php", "dest": "/api/admin/admin-dashboard.php" },
      { "src": "/admin/admin-login.php", "dest": "/api/admin/admin-login.php" },
      { "src": "/admin/edit-material.php", "dest": "/api/admin/edit-material.php" },
      { "src": "/admin/edit-product.php", "dest": "/api/admin/edit-product.php" },
      { "src": "/admin/footer-settings.php", "dest": "/api/admin/footer-settings.php" },
      { "src": "/admin/logout.php", "dest": "/api/admin/logout.php" },
      { "src": "/admin/manage-products.php", "dest": "/api/admin/manage-products.php" },
      { "src": "/admin/manage-industries.php", "dest": "/api/admin/manage-industries.php" },
      { "src": "/admin/manage-materials.php", "dest": "/api/admin/manage-materials.php" },
      { "src": "/about.php", "dest": "/api/about.php" },
      { "src": "/products.php", "dest": "/api/products.php" },
      { "src": "/product-detail.php", "dest": "/api/product-detail.php" },
      { "src": "/capabilities.php", "dest": "/api/capabilities.php" },
      { "src": "/contact.php", "dest": "/api/contact.php" },
      { "src": "/inquiry.php", "dest": "/api/inquiry.php" },
      { "src": "/submit_contact.php", "dest": "/api/submit_contact.php" },
      { "src": "/index.php", "dest": "/api/index.php" },
      { "src": "/", "dest": "/api/index.php" },
      { "src": "/(.*)",  "dest": "/api/index.php" }
    ]
  }
  